{
  "name": "网页搜索配置协议示例（非 BOSS 实际控件）",
  "platform": "other",
  "verified": false,
  "allowed_hosts": ["example.invalid"],
  "search": {
    "query": {"css": "#query"},
    "submit": {"css": "#search"},
    "reset_filters": {"css": "#reset-filters"},
    "results_ready": {"css": "#results-ready"},
    "filters": {
      "cities": {"kind": "select", "locator": {"css": "#city"}, "selected": {"css": "#selected-city-label"}, "options": {"上海": "上海", "深圳": "深圳"}, "coverage": "exact"},
      "salary": {"kind": "menu", "multiple": true, "locator": {"css": "#salary-menu"}, "option_role": "option", "selected": {"css": "#selected-salary-label"}, "bands": [{"key": "10-20", "label": "10-20K", "min": 10000, "max": 20000}, {"key": "20-50", "label": "20-50K", "min": 20000, "max": 50000}, {"key": "50+", "label": "50K以上", "min": 50000, "max": null}], "coverage": "site_band"}
    }
  },
  "notes": "将这个 search 对象与真实 collect 配置合并。定位器及选项文本必须从实际页面验证，不可照搬此示例。"
}
